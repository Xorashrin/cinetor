{
  "expo": {
    "name": "Cinetor",
    "slug": "cinetor",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/cinetor-icon.png",
    "scheme": ["cinetor", "cinator"],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1017",
    "android": {
      "package": "com.cinator.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#0B1017",
        "foregroundImage": "./assets/cinetor-foreground.png",
        "monochromeImage": "./assets/cinetor-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1017",
          "image": "./assets/cinetor-splash.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cinetor saves approved downloaded videos to your device storage.",
          "savePhotosPermission": "Cinetor saves approved downloaded videos to your device storage.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "video"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "minSdkVersion": 26,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.4.10",
            "extraMavenRepos": ["https://jitpack.io"],
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      "./plugins/withCinetorAndroid"
    ]
  }
}
